{
  "name": "amd",
  "displayName": "atlasmd",
  "description": "Gives Claude the Markdown files in docs/start/ at the start of a session and after a compaction, instead of the whole repository. Refuses a change to a file in a listed folder until Claude has read the files listed for that folder. Logs the date and the size of every compaction summary. Records the tokens of each session, so that amd meter compares sessions with atlasmd on and off.",
  "version": "0.3.6",
  "author": {
    "name": "simon-init"
  },
  "homepage": "https://github.com/simon-init/atlasmd",
  "repository": "https://github.com/simon-init/atlasmd",
  "license": "MIT",
  "keywords": [
    "context",
    "markdown",
    "docs",
    "hooks",
    "compaction",
    "tokens"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/atlasmd/hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/atlasmd/hook.py\"",
            "timeout": 15,
            "statusMessage": "atlasmd"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/atlasmd/hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/atlasmd/hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/atlasmd/hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/atlasmd/hook.py\"",
            "timeout": 15,
            "statusMessage": "atlasmd"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/atlasmd/hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/atlasmd/hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/atlasmd/hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/atlasmd/hook.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "userConfig": {
    "offer_setup": {
      "type": "boolean",
      "title": "Offer the setup",
      "description": "In a project without atlasmd.toml, say once that /amd:init sets it up.",
      "default": true
    }
  }
}
